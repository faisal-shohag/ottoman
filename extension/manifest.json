{
  "manifest_version": 3,
  "name": "Ottoman",
  "version": "0.1.0",
  "description": "Lets the Ottoman desktop assistant work in this browser.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Ottoman",
    "default_icon": {
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  }
}
